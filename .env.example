# ADASI Supplier Portal - production baseline
# Copy this file to .env on the server and replace every CHANGE_ME value.
# Never commit the deployed .env file or real credentials.

APP_NAME="ADASI Supplier Portal"
APP_ENV=production
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=false
APP_URL=https://portal.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Generate APP_KEY once on the first deployment with:
# php artisan key:generate --force
# Keep APP_KEY stable afterward because it protects encrypted application data.

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# Keep production logs useful without recording debug-level request details.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# MySQL / MariaDB (cPanel commonly prefixes database and user names).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CHANGE_ME_DATABASE
DB_USERNAME=CHANGE_ME_DATABASE_USER
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
# DB_SOCKET=
# MYSQL_ATTR_SSL_CA=

# Database-backed cache, session, and queue tables are included in migrations.
CACHE_STORE=database
CACHE_PREFIX=adasi_portal_

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_PARTITIONED_COOKIE=false

AUTH_PASSWORD_TIMEOUT=10800
AUTH_ABSOLUTE_TIMEOUT=480
AUTH_AUDIT_RETENTION_DAYS=180
AUTH_MAX_CONCURRENT_SESSIONS=3

AUTH_DISTINCT_EMAIL_THRESHOLD=5
AUTH_DISTINCT_EMAIL_WINDOW=300
AUTH_GLOBAL_FAILED_LOGIN_THRESHOLD=200
AUTH_GLOBAL_FAILED_LOGIN_WINDOW=300
AUTH_REPEATED_LOCKOUT_ALERT_THRESHOLD=3

AUTH_KNOWN_DEVICE_COOKIE=adasi_known_device
AUTH_KNOWN_DEVICE_LIFETIME_DAYS=400

# Keep this value unique and stable. Changing it changes generated public IDs.
HASHIDS_SALT=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE
HASHIDS_LENGTH=8

# Cloudflare Turnstile stays disabled while either key is empty.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_TIMEOUT_SECONDS=3
# TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# Keep empty when SSL terminates directly at Apache/LiteSpeed on cPanel.
# If a trusted proxy is introduced, use explicit comma-separated IP/CIDR values.
TRUSTED_PROXIES=

# Optional CSP report collector. The application policy remains report-only.
CSP_REPORT_URI=

FILESYSTEM_DISK=local

# Requires a persistent worker or a scheduled queue worker on shared hosting.
QUEUE_CONNECTION=database
# Leave unset to use DB_CONNECTION. Atomic export handoff requires the queue
# table and export_jobs to use the same Laravel database connection.
# DB_QUEUE_CONNECTION=mysql
DB_QUEUE_RETRY_AFTER=660
QUEUE_FAILED_DRIVER=database-uuids

# Pusher Channels is the active realtime provider. The 30-second notification
# and chat polling paths remain the fallback when Pusher is unavailable.
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=CHANGE_ME_PUSHER_APP_ID
PUSHER_APP_KEY=CHANGE_ME_PUSHER_APP_KEY
PUSHER_APP_SECRET=CHANGE_ME_PUSHER_APP_SECRET
PUSHER_APP_CLUSTER=CHANGE_ME_PUSHER_CLUSTER
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https

# cPanel SMTP. Obtain these values from "Configure Mail Client".
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.example.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=CHANGE_ME_MAILBOX_PASSWORD
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"
# MAIL_EHLO_DOMAIN=portal.example.com

# If cPanel specifies STARTTLS instead, use:
# MAIL_PORT=587
# MAIL_SCHEME=smtp

# Optional S3-compatible storage; unused while FILESYSTEM_DISK=local.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# AWS_ENDPOINT=
# AWS_URL=

VITE_APP_NAME="${APP_NAME}"

APP_NAME="ADASI Portal Supplier"
APP_ENV=testing
# Generate a dedicated testing key before running encryption-dependent tests.
APP_KEY=
APP_DEBUG=true
APP_URL=http://adasi_portal_supplier.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=adasi_portal_test
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=array
BROADCAST_CONNECTION=null
QUEUE_CONNECTION=sync
CACHE_STORE=array
MAIL_MAILER=array

AUTH_TARPIT_ENABLED=false

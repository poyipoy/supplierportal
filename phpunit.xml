<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         defaultTestSuite="Unit,Feature"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <!-- `composer test:parallel` only. Parallel + Serial = Unit + Feature.
             Serial lists tests pinned to adasi_portal_test: subprocess workers,
             migration/rollback tests and the database safety guard. -->
        <testsuite name="Parallel">
            <directory>tests/Unit</directory>
            <directory>tests/Feature</directory>
            <exclude>tests/Feature/AdvancedExportBaselineTest.php</exclude>
            <exclude>tests/Feature/AdvancedExportConcurrencyTest.php</exclude>
            <exclude>tests/Feature/AdvancedExportPerformanceTest.php</exclude>
            <exclude>tests/Feature/AdvancedExportQueuedCsvBaselineTest.php</exclude>
            <exclude>tests/Feature/GaClaimTypeMigrationTest.php</exclude>
            <exclude>tests/Feature/LocalInvoice/CancelledRecoveryConcurrencyTest.php</exclude>
            <exclude>tests/Feature/LocalInvoice/LegacyDatabaseUpgradeTest.php</exclude>
            <exclude>tests/Feature/LocalInvoice/LocalGrReservationConcurrencyTest.php</exclude>
            <exclude>tests/Feature/LocalInvoice/LocalImportProgressTest.php</exclude>
            <exclude>tests/Feature/LocalInvoice/LocalImportRevalidationConcurrencyTest.php</exclude>
            <exclude>tests/Feature/LocalInvoice/LocalImportRevalidationTest.php</exclude>
            <exclude>tests/Feature/LocalInvoice/LocalInvoiceConcurrencyTest.php</exclude>
            <exclude>tests/Feature/LocalInvoice/LocalInvoiceMigrationTest.php</exclude>
            <exclude>tests/Feature/LocalInvoice/LocalPoPrReferenceConcurrencyTest.php</exclude>
            <exclude>tests/Feature/LocalInvoice/ManualPoPrConcurrencyTest.php</exclude>
            <exclude>tests/Feature/LocaleRuntimeTest.php</exclude>
            <exclude>tests/Feature/LocalizationExportTest.php</exclude>
            <exclude>tests/Feature/LocalizationPerformanceTest.php</exclude>
            <exclude>tests/Feature/LocalizationRenderingTest.php</exclude>
            <exclude>tests/Feature/NotificationLocaleTest.php</exclude>
            <exclude>tests/Feature/Procurement/MasterDataDeletionDurabilityTest.php</exclude>
            <exclude>tests/Feature/Procurement/OrderedQuantityShipmentConcurrencyTest.php</exclude>
            <exclude>tests/Feature/Procurement/ReferencePriceConcurrencyTest.php</exclude>
            <exclude>tests/Feature/Procurement/ShipmentSubmissionConcurrencyTest.php</exclude>
            <exclude>tests/Feature/SupplierRegistration/SupplierRegistrationSubmissionRaceTest.php</exclude>
            <exclude>tests/Feature/TestingEnvironmentDatabaseSafetyTest.php</exclude>
            <exclude>tests/Feature/UserLocalePreferenceMigrationTest.php</exclude>
            <exclude>tests/Feature/UserLocalePreferencesTest.php</exclude>
            <exclude>tests/Feature/UserNotificationPreferenceMigrationTest.php</exclude>
            <exclude>tests/Feature/UserPreferenceConcurrencyTest.php</exclude>
            <exclude>tests/Feature/UserPreferenceMigrationTest.php</exclude>
            <exclude>tests/Feature/UserRegionalPreferencesTest.php</exclude>
        </testsuite>
        <testsuite name="Serial">
            <file>tests/Feature/AdvancedExportBaselineTest.php</file>
            <file>tests/Feature/AdvancedExportConcurrencyTest.php</file>
            <file>tests/Feature/AdvancedExportPerformanceTest.php</file>
            <file>tests/Feature/AdvancedExportQueuedCsvBaselineTest.php</file>
            <file>tests/Feature/GaClaimTypeMigrationTest.php</file>
            <file>tests/Feature/LocalInvoice/CancelledRecoveryConcurrencyTest.php</file>
            <file>tests/Feature/LocalInvoice/LegacyDatabaseUpgradeTest.php</file>
            <file>tests/Feature/LocalInvoice/LocalGrReservationConcurrencyTest.php</file>
            <file>tests/Feature/LocalInvoice/LocalImportProgressTest.php</file>
            <file>tests/Feature/LocalInvoice/LocalImportRevalidationConcurrencyTest.php</file>
            <file>tests/Feature/LocalInvoice/LocalImportRevalidationTest.php</file>
            <file>tests/Feature/LocalInvoice/LocalInvoiceConcurrencyTest.php</file>
            <file>tests/Feature/LocalInvoice/LocalInvoiceMigrationTest.php</file>
            <file>tests/Feature/LocalInvoice/LocalPoPrReferenceConcurrencyTest.php</file>
            <file>tests/Feature/LocalInvoice/ManualPoPrConcurrencyTest.php</file>
            <file>tests/Feature/LocaleRuntimeTest.php</file>
            <file>tests/Feature/LocalizationExportTest.php</file>
            <file>tests/Feature/LocalizationPerformanceTest.php</file>
            <file>tests/Feature/LocalizationRenderingTest.php</file>
            <file>tests/Feature/NotificationLocaleTest.php</file>
            <file>tests/Feature/Procurement/MasterDataDeletionDurabilityTest.php</file>
            <file>tests/Feature/Procurement/OrderedQuantityShipmentConcurrencyTest.php</file>
            <file>tests/Feature/Procurement/ReferencePriceConcurrencyTest.php</file>
            <file>tests/Feature/Procurement/ShipmentSubmissionConcurrencyTest.php</file>
            <file>tests/Feature/SupplierRegistration/SupplierRegistrationSubmissionRaceTest.php</file>
            <file>tests/Feature/TestingEnvironmentDatabaseSafetyTest.php</file>
            <file>tests/Feature/UserLocalePreferenceMigrationTest.php</file>
            <file>tests/Feature/UserLocalePreferencesTest.php</file>
            <file>tests/Feature/UserNotificationPreferenceMigrationTest.php</file>
            <file>tests/Feature/UserPreferenceConcurrencyTest.php</file>
            <file>tests/Feature/UserPreferenceMigrationTest.php</file>
            <file>tests/Feature/UserRegionalPreferencesTest.php</file>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="HASHIDS_SALT" value="adasi-isolated-test-salt-never-use-in-production" force="true"/>
        <env name="PORTAL_LONG_HASHIDS_ENABLED" value="false" force="true"/>
        <env name="PORTAL_PATH_PREFIX_ENABLED" value="false" force="true"/>
        <env name="PORTAL_PAGE_REGISTRY_ENABLED" value="false" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <!-- Dummy verification hash for the constant-time login path. Cost must
             track BCRYPT_ROUNDS above, or the miss branch costs ~200ms per
             failed login while the hit branch costs ~1ms. -->
        <env name="AUTH_DUMMY_HASH" value="$2y$04$PIaDjQhlFb2EYQPyu9.sa.7DTQ4tAZxYbPlaT8tEoER/f686zf4D."/>
        <!-- The tarpit sleeps real seconds; LoginSecurityTest enables it
             explicitly for the one test that asserts the delay. -->
        <env name="AUTH_TARPIT_ENABLED" value="false"/>
        <!-- Mission 05: suites outside tests/Feature/Procurement/ShipmentMtcTest
             keep the pre-R3 shipment flow; that test enables the switch. -->
        <env name="PROCUREMENT_SHIPMENT_MTC_ENABLED" value="false"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="adasi_portal_test"/>
        <env name="DB_USERNAME" value="root"/>
        <env name="DB_PASSWORD" value=""/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
